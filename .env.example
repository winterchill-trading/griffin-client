# Copy to .env (gitignored) and fill in. Never commit real values.
GRIFFIN_API_KEY=
GRIFFIN_API_BASE_URL=https://api.griffin.com
# Optional: RFC 9421 request signing (Ed25519). Base64 or PEM private key and the
# key id shown in the app after registering the public key.
GRIFFIN_SIGNING_KEY=
GRIFFIN_SIGNING_KEY_ID=
