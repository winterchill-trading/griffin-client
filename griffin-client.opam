opam-version: "2.0"
synopsis: "Async client and CLI for the Griffin banking API"
description:
  "Typed Griffin API resources (organization, legal persons, bank accounts, payments, payees, Confirmation of Payee, events), hypermedia index navigation, RFC 9421 request signing and webhook signature verification."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/griffin-client"
bug-reports: "https://github.com/winterchill-trading/griffin-client/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "async_ssl"
  "cohttp"
  "cohttp-async"
  "conduit-async"
  "uri"
  "yojson"
  "ppx_jane"
  "ppx_yojson_conv"
  "ppx_yojson_conv_lib"
  "cryptokit"
  "zarith"
  "base64"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/griffin-client.git"
