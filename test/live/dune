; The live sandbox walk. [dune test] runs it, but it only talks to Griffin when
; GRIFFIN_API_KEY is set and GRIFFIN_LIVE_TESTS=1; otherwise it prints one line and
; exits 0, which is what CI (no credentials) sees.

(executable
 (name live)
 (libraries core async core_unix.command_unix griffin-client yojson)
 (preprocess
  (pps ppx_jane)))

(rule
 (alias runtest)
 (action
  (run %{exe:live.exe})))
